# ============================================================
# Backend Environment Configuration
# ============================================================

# Secret key for Day 12 service authentication (required for /ask endpoint and CP1-CP3)
AGENT_API_KEY=doi-thanh-khoa-cua-rieng-ban

# MongoDB Connection URI (use mongodb://mongo:27017/rag_chatbot in Docker or cloud MongoDB Atlas URI)
MONGODB_URI=mongodb://mongo:27017/rag_chatbot
MONGODB_DB_NAME=rag_chatbot

# JWT Secret for user authentication tokens (min 32 characters)
JWT_SECRET=super-secret-rag-jwt-key-2026-production-ready-32b

# Redis connection URL (used for rate limiting, sliding window, and conversation state)
REDIS_URL=redis://redis:6379/0

# Optional: Google OAuth Client ID for login integration
GOOGLE_CLIENT_ID=

# Optional: OpenAI API Key for real LLM responses (falls back to mock_llm if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Allowed origins for CORS (comma separated, or * for all)
ALLOWED_ORIGINS=*

# Path for file upload storage
STORAGE_DIR=./storage/uploads

# Server Port
PORT=8000

# Rate limiting and cost guard settings
RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=10.0
LOG_LEVEL=INFO
DEFAULT_USAGE_LIMIT=100
